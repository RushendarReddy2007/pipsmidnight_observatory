# ==============================================================================
# PIP'S MIDNIGHT OBSERVATORY — ENVIRONMENT CONFIGURATION
# haX.baby Hackathon Track 1: Pip the Skull Baby
# ==============================================================================
# The website works 100% offline with a rich built-in response engine even without
# any API keys. If you want to connect a live LLM for open-ended AI conversation,
# copy this file to .env and provide your API key below:

# Option A: Google Gemini API (Recommended)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Option B: OpenAI API (Alternative)
# OPENAI_API_KEY=

# Server Port (Default is 3333)
PORT=3333
